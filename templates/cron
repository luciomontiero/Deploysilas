SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Daily backup at 02:10.
10 2 * * * deploy /usr/local/bin/deploysilas backup >> /var/log/deploysilas-cron.log 2>&1

# Daily cleanup at 03:10.
10 3 * * * deploy /usr/local/bin/deploysilas cleanup >> /var/log/deploysilas-cron.log 2>&1
